            "summarizeBy": "none"
          },
          {
            "name": "revenue_delta_cents",
            "dataType": "int64",
            "sourceColumn": "revenue_delta_cents",
            "lineageTag": "e4f09d55-de4f-5e1d-8713-349985db7e35",
            "summarizeBy": "sum"
          },
          {
            "name": "incentive_delta_cents",
            "dataType": "int64",
            "sourceColumn": "incentive_delta_cents",
            "lineageTag": "97295a67-b9b5-5e84-ba07-ce3f0cfe80b2",
            "summarizeBy": "sum"
          },
          {
            "name": "cost_delta_cents",
            "dataType": "int64",
            "sourceColumn": "cost_delta_cents",
            "lineageTag": "1c5190dd-cffa-537c-bc6a-758576eee9ed",
            "summarizeBy": "sum"
          }
        ],
        "partitions": [
          {
            "name": "Controls",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(DataFolder & \"\\controls.csv\"), [Delimiter=\",\", Columns=5, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    BlanksToNull = Table.ReplaceValue(Headers, \"\", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),",
                "    Typed = Table.TransformColumnTypes(BlanksToNull, {{\"service_date\", type date}, {\"cluster_id\", Int64.Type}, {\"revenue_delta_cents\", Int64.Type}, {\"incentive_delta_cents\", Int64.Type}, {\"cost_delta_cents\", Int64.Type}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Reconciliation Absolute Delta USD",
            "expression": "DIVIDE(SUMX(Controls,ABS(Controls[revenue_delta_cents])+ABS(Controls[incentive_delta_cents])+ABS(Controls[cost_delta_cents])),100)",
            "formatString": "$0.00",
            "lineageTag": "269e0d9b-6787-5825-9df8-2d1bab413b9e",
            "displayFolder": "Practice metrics"
          },
          {
            "name": "Reconciliation Exception Rows",
            "expression": "COALESCE(COUNTROWS(FILTER(Controls,Controls[revenue_delta_cents]<>0 || Controls[incentive_delta_cents]<>0 || Controls[cost_delta_cents]<>0)),0)",
            "formatString": "#,0",
            "lineageTag": "6ef0bcf1-2eed-58ca-a5b5-94063d5692a2",
            "displayFolder": "Practice metrics"
          },
          {
            "name": "Imported Control Rows",
            "expression": "COUNTROWS(Controls)",
            "formatString": "#,0",
            "lineageTag": "fd276410-b3d3-57b8-af47-f098fb2f4dcd",
            "displayFolder": "Practice metrics"
          }
        ]
      },
