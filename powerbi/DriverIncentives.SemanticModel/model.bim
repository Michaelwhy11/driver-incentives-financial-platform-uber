        "partitions": [
          {
            "name": "PairEffects",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(DataFolder & \"\\pair_effects.csv\"), [Delimiter=\",\", Columns=9, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    BlanksToNull = Table.ReplaceValue(Headers, \"\", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),",
                "    Typed = Table.TransformColumnTypes(BlanksToNull, {{\"pair_id\", Int64.Type}, {\"treatment_market\", Int64.Type}, {\"control_market\", Int64.Type}, {\"trips_effect\", type number}, {\"gross_bookings_effect_usd\", type number}, {\"revenue_effect_usd\", type number}, {\"incentive_effect_usd\", type number}, {\"variable_cost_effect_usd\", type number}, {\"contribution_effect_usd\", type number}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Adjusted Revenue Effect USD",
            "expression": "AVERAGE(PairEffects[revenue_effect_usd])",
            "formatString": "$0.00;($0.00)",
            "lineageTag": "c885e2f8-c649-5b4a-b2fb-5b1a412d293c",
            "displayFolder": "Practice metrics"
          },
          {
            "name": "Adjusted Contribution Effect USD",
            "expression": "AVERAGE(PairEffects[contribution_effect_usd])",
            "formatString": "$0.00;($0.00)",
            "lineageTag": "618a3359-d11b-5ce8-9da0-7b0dd85e521d",
            "displayFolder": "Practice metrics"
          },
          {
            "name": "Pair Count",
            "expression": "COUNTROWS(PairEffects)",
            "formatString": "#,0",
            "lineageTag": "eb60ad78-e0f0-58b1-b0f4-353b61932a5c",
            "displayFolder": "Practice metrics"
          },
          {
            "name": "Revenue Effect SE USD",
            "expression": "DIVIDE(STDEV.S(PairEffects[revenue_effect_usd]),SQRT([Pair Count]))",
            "formatString": "$0.00",
            "lineageTag": "52072289-6a53-5834-ab42-112acb6f5c1a",
            "displayFolder": "Practice metrics"
          },
          {
            "name": "Contribution Effect SE USD",
            "expression": "DIVIDE(STDEV.S(PairEffects[contribution_effect_usd]),SQRT([Pair Count]))",
            "formatString": "$0.00",
            "lineageTag": "28648758-be0b-5eea-a519-5fd43d95a587",
            "displayFolder": "Practice metrics"
          },
          {
            "name": "Revenue Effect CI Lower USD",
            "expression": "IF([Pair Count]=24,[Adjusted Revenue Effect USD]-2.068657610*[Revenue Effect SE USD])",
            "formatString": "$0.00;($0.00)",
            "lineageTag": "03f81685-f817-54a9-a605-3e53143507f8",
            "displayFolder": "Practice metrics"
          },
          {
            "name": "Revenue Effect CI Upper USD",
            "expression": "IF([Pair Count]=24,[Adjusted Revenue Effect USD]+2.068657610*[Revenue Effect SE USD])",
            "formatString": "$0.00;($0.00)",
            "lineageTag": "574ee6ee-495f-5086-a535-0567eaea0450",
            "displayFolder": "Practice metrics"
          },
          {
            "name": "Contribution Effect CI Lower USD",
            "expression": "IF([Pair Count]=24,[Adjusted Contribution Effect USD]-2.068657610*[Contribution Effect SE USD])",
            "formatString": "$0.00;($0.00)",
            "lineageTag": "f35be996-3413-5a86-a1fb-42066d004e3c",
            "displayFolder": "Practice metrics"
          },
          {
            "name": "Contribution Effect CI Upper USD",
            "expression": "IF([Pair Count]=24,[Adjusted Contribution Effect USD]+2.068657610*[Contribution Effect SE USD])",
            "formatString": "$0.00;($0.00)",
            "lineageTag": "48ccc0ca-1657-593a-a968-9a3a15d10950",
            "displayFolder": "Practice metrics"
          }
        ]
