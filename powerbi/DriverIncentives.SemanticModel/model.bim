          }
        ],
        "partitions": [
          {
            "name": "Finance",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(DataFolder & \"\\finance.csv\"), [Delimiter=\",\", Columns=11, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    BlanksToNull = Table.ReplaceValue(Headers, \"\", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),",
                "    Typed = Table.TransformColumnTypes(BlanksToNull, {{\"service_date\", type date}, {\"cluster_id\", Int64.Type}, {\"trips\", Int64.Type}, {\"gross_bookings_cents\", Int64.Type}, {\"revenue_cents\", Int64.Type}, {\"incentive_cents\", Int64.Type}, {\"variable_cost_cents\", Int64.Type}, {\"contribution_cents\", Int64.Type}, {\"pair_id\", Int64.Type}, {\"assigned_group\", type text}, {\"period\", type text}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Total Trips",
            "expression": "SUM(Finance[trips])",
            "formatString": "#,0",
            "lineageTag": "a06e18a6-ec5d-5866-b578-0a2e694c57dc",
            "displayFolder": "Practice metrics"
          },
          {
            "name": "Gross Bookings USD",
            "expression": "DIVIDE(SUM(Finance[gross_bookings_cents]),100)",
            "formatString": "$#,0.00;($#,0.00)",
            "lineageTag": "1eee7989-549b-58fc-bfde-baeeaf9014e7",
            "displayFolder": "Practice metrics"
          },
          {
            "name": "Revenue USD",
            "expression": "DIVIDE(SUM(Finance[revenue_cents]),100)",
            "formatString": "$#,0.00;($#,0.00)",
            "lineageTag": "3107b0df-f92c-50fb-9fd8-80c801c0bb61",
            "displayFolder": "Practice metrics"
          },
          {
            "name": "Incentives USD",
            "expression": "DIVIDE(SUM(Finance[incentive_cents]),100)",
            "formatString": "$#,0.00;($#,0.00)",
            "lineageTag": "bd4b220f-02a2-5773-a5e9-58682bfc27c2",
            "displayFolder": "Practice metrics"
          },
          {
            "name": "Variable Costs USD",
            "expression": "DIVIDE(SUM(Finance[variable_cost_cents]),100)",
            "formatString": "$#,0.00;($#,0.00)",
            "lineageTag": "2d56032a-695a-55d8-8e83-4a68c3810d5e",
            "displayFolder": "Practice metrics"
          },
          {
            "name": "Contribution USD",
            "expression": "DIVIDE(SUM(Finance[contribution_cents]),100)",
            "formatString": "$#,0.00;($#,0.00)",
            "lineageTag": "21566b1a-0b7b-57a2-80f8-7c445bf0599d",
            "displayFolder": "Practice metrics"
          },
          {
            "name": "Revenue per Trip USD",
            "expression": "DIVIDE([Revenue USD],[Total Trips])",
            "formatString": "$0.00",
            "lineageTag": "76f12019-d555-5ea1-8bf1-3897c7adaf80",
            "displayFolder": "Practice metrics"
          },
          {
            "name": "Contribution per Trip USD",
            "expression": "DIVIDE([Contribution USD],[Total Trips])",
            "formatString": "$0.00",
            "lineageTag": "f9830555-faca-52f2-9e76-40e8e5feefb0",
            "displayFolder": "Practice metrics"
          },
          {
            "name": "Contribution Margin",
            "expression": "DIVIDE([Contribution USD],[Revenue USD])",
            "formatString": "0.0%",
            "lineageTag": "9cdec032-794e-5da7-8cb0-e4af2e0192d5",
            "displayFolder": "Practice metrics"
          },
          {
            "name": "Contribution Identity Errors",
            "expression": "COALESCE(COUNTROWS(FILTER(Finance,Finance[revenue_cents]-Finance[incentive_cents]-Finance[variable_cost_cents]<>Finance[contribution_cents])),0)",
            "formatString": "#,0",
            "lineageTag": "04c83151-606f-517a-af77-4eecba9ce77f",
            "displayFolder": "Practice metrics"
          }
        ]
      },
