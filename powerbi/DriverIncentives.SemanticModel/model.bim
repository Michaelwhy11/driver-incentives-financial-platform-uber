            "displayFolder": "Practice metrics"
          },
          {
            "name": "Revenue Forecast MAE USD",
            "expression": "AVERAGEX(VALUES(Backtest[forecast_date]),ABS(CALCULATE([Backtest Actual Revenue USD])-CALCULATE([Backtest Predicted Revenue USD])))",
            "formatString": "$0.00",
            "lineageTag": "f5540034-0153-5c46-91a5-5b8a91af5e40",
            "displayFolder": "Practice metrics"
          },
          {
            "name": "Revenue Forecast WAPE",
            "expression": "DIVIDE(SUMX(VALUES(Backtest[forecast_date]),ABS(CALCULATE([Backtest Actual Revenue USD])-CALCULATE([Backtest Predicted Revenue USD]))),SUMX(VALUES(Backtest[forecast_date]),ABS(CALCULATE([Backtest Actual Revenue USD]))))",
            "formatString": "0.00%",
            "lineageTag": "176cdcb4-4d15-564d-8e81-55623c69b4d4",
            "displayFolder": "Practice metrics"
          },
          {
            "name": "Contribution Forecast MAE USD",
