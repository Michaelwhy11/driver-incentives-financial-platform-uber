            "formatString": "$0.00",
            "lineageTag": "60c74a03-704a-5afd-a996-2284dce5f088",
            "displayFolder": "Practice metrics"
          },
          {
            "name": "Contribution Forecast WAPE",
            "expression": "DIVIDE(SUMX(VALUES(Backtest[forecast_date]),ABS(CALCULATE([Backtest Actual Contribution USD])-CALCULATE([Backtest Predicted Contribution USD]))),SUMX(VALUES(Backtest[forecast_date]),ABS(CALCULATE([Backtest Actual Contribution USD]))))",
